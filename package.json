{
  "name": "jingjian-film-aesthetics",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "images:optimize": "node scripts/optimize-images.mjs",
    "palette:tones": "node scripts/extract-frame-tones.mjs",
    "studio": "node scripts/studio/serve.mjs",
    "studio:audit": "node scripts/studio/audit.mjs",
    "studio:palette": "node scripts/studio/palette-check.mjs",
    "studio:style": "node --experimental-strip-types --disable-warning=MODULE_TYPELESS_PACKAGE_JSON --import ./scripts/studio/ts-loader.mjs scripts/studio/style-check.mts",
    "studio:style-demo": "node --experimental-strip-types --disable-warning=MODULE_TYPELESS_PACKAGE_JSON --import ./scripts/studio/ts-loader.mjs scripts/studio/style-demo.mts",
    "proxy:dev": "node server/rh-proxy/dev-server.mjs",
    "proxy:test": "node --test server/rh-proxy/test/flow.test.mjs"
  },
  "dependencies": {
    "next": "16.3.4",
    "react": "19.2.8",
    "react-dom": "19.2.8"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "autoprefixer": "^10.4.20",
    "eslint": "^9.17.0",
    "eslint-config-next": "16.3.4",
    "postcss": "^8.4.49",
    "sharp": "^0.35.4",
    "tailwindcss": "^3.4.17",
    "typescript": "^5.7.2"
  }
}
